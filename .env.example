# Copy to .env for local development.
# DATABASE_URL is an optional explicit override. When it is unset, the app
# builds the asyncpg URL from the POSTGRES_* values below, percent-encoding
# the user and password.
POSTGRES_DB=daily_signal
POSTGRES_USER=daily_signal
POSTGRES_PASSWORD=daily_signal
LOG_LEVEL=INFO
RATE_LIMIT_PER_MINUTE=120
SCHEDULER_TICK_SECONDS=900
CORS_ORIGINS=[]
